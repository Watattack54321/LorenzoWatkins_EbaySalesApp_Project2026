	  <Property Name="ClientSize" Type="System.Drawing.Size">600,400</Property>
	  <Property Name="Name">LorenzoWatkins_EbaySalesApp_ProjectForm1</Property>
	  <Property Name="Text">EbaySalesApp</Property>
	</Properties>
	<Controls>
