  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns="http://schemas.microsoft.com/VisualStudio/2004/01/design">

  <DesignTimeMeta>
	<Type Name="LorenzoWatkins_EbaySalesApp_Project.LorenzoWatkins_EbaySalesApp_ProjectForm1"/>
